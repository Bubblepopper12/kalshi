# Postgres + TimescaleDB (see docker-compose.yml). SQLite works for a quick local try:
#   PICKS_DATABASE_URL=sqlite:///picks.db
PICKS_DATABASE_URL=postgresql+psycopg://picks:picks@localhost:5432/picks

# Kalshi public market data. No API key: this engine never trades.
KALSHI_API_BASE=https://external-api.kalshi.com/trade-api/v2
KALSHI_REQUESTS_PER_SECOND=8

# Kalshi taker fee rate (fee = ceil_to_cent(rate * contracts * P * (1 - P))).
KALSHI_FEE_RATE=0.07
# Contract count used when turning the fee into a per-contract cost on the board.
KALSHI_FEE_CONTRACTS=100

# ---------------------------------------------------------------- trading (approval-only)
# demo = Kalshi's practice exchange (demo.kalshi.co, play money, its own account and keys).
# live = real money. Change this only on purpose.
KALSHI_ENV=demo
# From Kalshi: Account & security -> API keys. Keep the .key file on this machine only
# (chmod 600). Never paste the private key into a chat, email or repository.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=~/.kalshi/demo.key

# Hard limits, checked again right before every order is sent.
PICKS_MAX_ORDER_DOLLARS=10
PICKS_MAX_DAILY_DOLLARS=50
PICKS_MAX_CONTRACTS_PER_ORDER=100
PICKS_MAX_OPEN_ORDERS=5
PICKS_MIN_PRICE=0.03
PICKS_MAX_PRICE=0.95
# Unapproved tickets expire after this many minutes; sent orders stop resting after this many.
PICKS_TICKET_TTL_MINUTES=30
PICKS_ORDER_EXPIRY_MINUTES=15
# Optional: override the trading host for KALSHI_ENV (normally leave unset).
# KALSHI_TRADING_BASE=
